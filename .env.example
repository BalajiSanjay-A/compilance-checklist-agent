# ==============================================================================
# Compliance Checklist Automation Agent - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME="Compliance Checklist Automation Agent"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL is production source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_db
# Set USE_SQLITE_FALLBACK=true to use SQLite for lightweight local dev without PostgreSQL
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=./compliance.db

# Storage Configuration
STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_MB=25

# AI / Grok API Configuration (xAI API)
XAI_API_KEY=your_xai_grok_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta
AI_MOCK_MODE=true

# Evidence Expiration Configuration
EXPIRATION_WARNING_DAYS=30

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_bytes_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_USERNAME=compliance_admin
DEFAULT_ADMIN_EMAIL=admin@compliance.local
DEFAULT_ADMIN_PASSWORD=change_this_password_immediately

# Background Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=5
WORKER_LEASE_TIMEOUT_SECONDS=600
